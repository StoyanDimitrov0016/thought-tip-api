generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SegmentationType {
  CATEGORY @map("category")
  TOPIC    @map("topic")
  TAG      @map("tag")
}

// TODO: make "name" unique too or at least unique for siblings (@@unique([parentId, name]))
// TODO: add "updatedBy" and "popularityScore" in the future
model Segmentation {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String @unique
  description String

  type SegmentationType

  parentId String?        @db.ObjectId
  parent   Segmentation?  @relation("SegmentationHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Segmentation[] @relation("SegmentationHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
